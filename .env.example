# Public origin of this deployment, e.g. the production domain once registered. Used to build
# absolute URLs in page metadata (the canonical address, og:url, and preview image of the landing
# page, the docs, the privacy policy and terms of use, and public project pages; left out while
# this is empty), the sitemap and robots.txt, the formulaUrl links of the public metrics route, and
# the links in alert emails and channel messages, which a production build refuses to send without
# it. Leave empty locally (links then point at http://localhost:3000); set per environment in the
# host's settings.
NEXT_PUBLIC_SITE_URL=

# Supabase API URL. Locally: "API URL" from `supabase status`. Hosted: Project Settings, API.
# There is no JWT secret variable: sessions are verified with this project's public signing keys
# when it signs with an asymmetric key, and through an Auth server call per request when it still
# uses the legacy secret. docs/operations/deploy.md, JWT signing keys, says how to switch.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...), safe for the browser because row level security
# applies. Locally: "Publishable key" from `supabase status`. Hosted: Project Settings, API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase service role key. Secret, server only, bypasses row level security; never prefix it
# with NEXT_PUBLIC_. Locally: SERVICE_ROLE_KEY from `supabase status -o env`. Hosted: Project
# Settings, API Keys.
SUPABASE_SERVICE_ROLE_KEY=

# Key that encrypts stored provider credentials (AES-256-GCM). Secret, server only, never prefix
# with NEXT_PUBLIC_, never store it in the database. Base64 of exactly 32 random bytes; generate
# one with `openssl rand -base64 32`. Losing it means every connection must reconnect.
STACKDASH_ENCRYPTION_KEY=
# Previous keys kept readable during rotation, comma separated as keyId:base64Key, where keyId is
# the first 8 hex characters of the SHA-256 of the key. Leave empty unless rotating; see the
# header of scripts/rotate-encryption-key.ts and run `npm run keys:rotate`.
STACKDASH_ENCRYPTION_KEYS_PREVIOUS=

# Bearer secret that POST /api/jobs/tick requires from the scheduler (pg_cron). Secret, server only,
# at least 32 characters; generate one with `openssl rand -hex 32`. `npm run jobs:tick` does not need it.
CRON_SECRET=

# Super admins (#250): who can open the instance overview at /app/admin, which shows whether each
# setting here is set (never its value) and instance-wide figures (users, workspaces, members,
# events, providers, jobs). Comma separated email addresses, matched without regard to case against
# the email the person signs in with (their GitHub primary email). Empty means nobody; anyone not
# listed gets page not found. An entry that is not an email address makes the page fail to load, and
# hides the Admin link and the Admin command from every super admin, with admin.link_check_failed in
# the server log.
STACKDASH_SUPER_ADMIN_EMAILS=

# ── Alert email ───────────────────────────────────────────────────────────────────────────────────
# Alert email goes through Resend, so a self-hosted install needs a Resend account and a verified
# sending domain. Without STACKDASH_RESEND_API_KEY, alerts still show in the app and reach channels,
# and alert settings says email is not set up.
# Sender address for alert emails, optionally with a name: StackDash alerts <alerts@your-domain>, on a
# domain verified in your Resend account. Locally any address, such as alerts@example.com.
STACKDASH_EMAIL_FROM=
# Resend API key with sending access (resend.com, API Keys). Secret, server only. Locally, with the
# fake below, any value: the fake accepts the key set here.
STACKDASH_RESEND_API_KEY=
# Where to send instead of https://api.resend.com (the default when empty). Locally
# http://127.0.0.1:55430, the fake Resend API that `npm run email:fake` starts and that prints each
# email it receives. https only, except plain http to this computer; scheme, host, and port only.
STACKDASH_RESEND_API_URL=

# Set to exactly 1 to let generic webhook channels post to plain http and to private network
# addresses (127.0.0.1, 10.0.0.0/8, and so on, written in the URL or resolved from its host name) in a
# production build. Checked on every post, so removing it stops such posts at once. Only for a
# self-hosted instance whose receivers live on its own network; never on a hosted instance.
# Development allows them anyway.
STACKDASH_ALLOW_PRIVATE_WEBHOOKS=

# Self-hosted only: how many proxies in front of the app append the client address to
# x-forwarded-for (a whole number from 1 to 9; 1 when unset). The per IP rate limit of the public
# badge, card, and metrics routes reads the entry that many places from the right, so a
# client cannot choose its own address. The app must sit behind such a proxy: reached directly, the
# limit counts per claimed address. Ignored on Vercel, where VERCEL=1 and the client comes from
# x-vercel-forwarded-for.
STACKDASH_TRUSTED_PROXY_COUNT=

# ── Operator: privacy policy and terms of use (#339) ──────────────────────────────────────────────
# Who runs this instance. /privacy and /terms name them, and the sign-in page, the footer, and the
# sitemap link to both. Set all three or none: with none, both pages answer 404 and nothing links to
# them; with only some, `next build` and every page with the footer fail with an error that names
# the missing one. Not secret, server only. The home page and both legal pages are prerendered, so
# set these before `next build` and deploy again after changing one. The policy's processors follow
# the same build: Vercel only when built on Vercel (`VERCEL=1`), "Hosting" otherwise, Resend only
# when STACKDASH_RESEND_API_KEY above is set and STACKDASH_RESEND_API_URL is empty or Resend's own API,
# and "Email" when it names another server. A key without STACKDASH_EMAIL_FROM then fails the build.
# Locally leave them empty unless you are working on those pages.
# The person or company responsible for the data this instance holds, e.g. Your Company Ltd.
STACKDASH_OPERATOR_NAME=
# One email address for privacy and data requests, e.g. privacy@your-domain.
STACKDASH_OPERATOR_EMAIL=
# The law the terms of use are governed by, as it reads after "the law of", e.g. England and Wales.
STACKDASH_GOVERNING_LAW=

# GitHub OAuth app for signing in to StackDash (not the GitHub App that reads billing data). Register
# one at https://github.com/settings/developers with the authorization callback URL
# http://127.0.0.1:55421/auth/v1/callback locally (hosted: https://<project-ref>.supabase.co/auth/v1/callback).
# Read by the Supabase CLI, not by Next.js: put these two in supabase/.env.local (git ignored) or
# export them before `supabase start`. The CLI refuses to start without them because the GitHub
# provider is enabled; any placeholder works when you only run the e2e suite, which never signs
# in through GitHub. Hosted: Authentication, Sign In / Providers, GitHub in the Supabase dashboard.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# ── Provider OAuth apps ───────────────────────────────────────────────────────────────────────────
# Each provider needs its own app registered by whoever runs this instance; docs/providers/<id>.md
# explains how. A provider with any required value empty shows "Not set up on this instance" in the
# catalog. Secrets are server only: never prefix them with NEXT_PUBLIC_. The callback URL for each
# is <SITE_URL>/api/connections/<id>/callback, where <SITE_URL> is NEXT_PUBLIC_SITE_URL when set,
# otherwise the origin the app is served from (http://localhost:3000 locally).

# Vercel Integration. Callback URL: <SITE_URL>/api/connections/vercel/callback
# Client id of the Vercel Integration (Integration Console, Credentials).
VERCEL_CLIENT_ID=
# Client secret of the Vercel Integration. Secret.
VERCEL_CLIENT_SECRET=
# URL slug of the integration, the <slug> in https://vercel.com/integrations/<slug>.
VERCEL_INTEGRATION_SLUG=

# GitHub App (not the sign-in OAuth app above). Callback URL and Setup URL: <SITE_URL>/api/connections/github/callback
# Client id of the GitHub App (app settings, General).
GITHUB_APP_CLIENT_ID=
# Client secret of the GitHub App. Secret.
GITHUB_APP_CLIENT_SECRET=
# URL slug of the app, the <slug> in https://github.com/apps/<slug>.
GITHUB_APP_SLUG=
# Numeric App ID of the GitHub App (app settings, General).
GITHUB_APP_ID=
# Private key of the GitHub App in PEM format, newlines as \n. Secret.
GITHUB_APP_PRIVATE_KEY=
# Webhook secret set on the GitHub App (app settings, Webhook), which signs every delivery to
# <SITE_URL>/api/webhooks/github. Unset while the webhook is inactive (an instance GitHub cannot
# reach); polling still brings the events. Not read while STACKDASH_SIMULATE_PROVIDERS is set. Secret.
GITHUB_APP_WEBHOOK_SECRET=

# Resend OAuth client (registered through the Resend API). Callback URL: <SITE_URL>/api/connections/resend/callback
# Client id returned when the client was registered.
RESEND_CLIENT_ID=
# Client secret returned when the client was registered. Secret.
RESEND_CLIENT_SECRET=

# Polar OAuth client (Account Settings, Developer; confidential client). Callback URL: <SITE_URL>/api/connections/polar/callback
# Client id of the Polar OAuth client.
POLAR_CLIENT_ID=
# Client secret of the Polar OAuth client. Secret.
POLAR_CLIENT_SECRET=

# Stripe App. Callback URL (allowed_redirect_uris in the app manifest): <SITE_URL>/api/connections/stripe/callback
# Client id of the Stripe App (Dashboard, Apps, the app's OAuth settings).
STRIPE_APP_CLIENT_ID=
# Live mode secret key of the Stripe account that owns the app, used for the token exchange. Secret.
STRIPE_APP_SECRET_KEY=
# Optional test mode secret key, used instead of the live key for test mode installs. Secret.
STRIPE_APP_TEST_SECRET_KEY=

# Supabase OAuth app (organization settings, OAuth Apps). Callback URL: <SITE_URL>/api/connections/supabase/callback
# Client id of the Supabase OAuth app.
SUPABASE_OAUTH_CLIENT_ID=
# Client secret of the Supabase OAuth app. Secret.
SUPABASE_OAUTH_CLIENT_SECRET=

# DigitalOcean OAuth app (control panel, API, OAuth Applications). Callback URL: <SITE_URL>/api/connections/digitalocean/callback
# Client ID from the app's View dialog.
DIGITALOCEAN_CLIENT_ID=
# Client secret from the app's View dialog. Secret.
DIGITALOCEAN_CLIENT_SECRET=
# PostHog client ID metadata document: nothing to register in PostHog, StackDash serves the
# document itself and needs a public HTTPS origin. Callback URL: <SITE_URL>/api/connections/posthog/callback
# Exactly <SITE_URL>/oauth/posthog/client-metadata, the URL of the document; it is the client id.
POSTHOG_OAUTH_CLIENT_ID=
# Private key that signs token requests (private_key_jwt), PEM, newlines as \n. Secret. Generate one with
# `openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256`; docs/providers/posthog.md has the steps.
POSTHOG_OAUTH_PRIVATE_KEY=
# GitLab.com OAuth application (avatar, Edit profile, Access, Applications; Confidential checked, scopes
# read_api and read_user only). Callback URL: <SITE_URL>/api/connections/gitlab/callback
# Application ID of the GitLab application.
GITLAB_CLIENT_ID=
# Secret of the GitLab application. Secret.
GITLAB_CLIENT_SECRET=

# Sentry public integration (Settings, Developer Settings, Custom Integrations). Redirect URL: <SITE_URL>/api/connections/sentry/callback
# Client ID shown on the integration's page under Credentials.
SENTRY_CLIENT_ID=
# Client Secret shown on the integration's page under Credentials. Also signs the token refresh. Secret.
SENTRY_CLIENT_SECRET=
# Slug of the integration, the <slug> in https://sentry.io/sentry-apps/<slug>/external-install/.
SENTRY_INTEGRATION_SLUG=
# Railway OAuth app (workspace settings, Developer, New OAuth App, type Web). Callback URL: <SITE_URL>/api/connections/railway/callback
# Client id of the Railway OAuth app.
RAILWAY_CLIENT_ID=
# Client secret of the Railway OAuth app, shown once when the app is created. Secret.
RAILWAY_CLIENT_SECRET=

# Fake provider for tests and e2e only. Never set in production. Callback URL: <SITE_URL>/api/connections/fake/callback
# Set to exactly 1 to offer the in-memory "Example provider" and its dev-only consent screen.
STACKDASH_ENABLE_FAKE_PROVIDER=
# Any non-empty value; the fake provider never sends it anywhere. Example: fake-client
FAKE_PROVIDER_CLIENT_ID=
# Any non-empty value; the fake provider never sends it anywhere. Example: fake-secret
FAKE_PROVIDER_CLIENT_SECRET=
# Dev and e2e only: signs the fake provider's deliveries to <SITE_URL>/api/webhooks/fake (empty answers 503); e2e sets its own.
STACKDASH_FAKE_WEBHOOK_SECRET=

# Simulated providers for local demos and testing only. Never set in production; it is refused
# on a Vercel production deployment even when set. Set to exactly 1 to replace Vercel, GitHub,
# Resend, Stripe, Supabase, DigitalOcean, PostHog, Polar, Sentry, Railway, and GitLab with simulated versions that need no
# OAuth app and make up their data on this machine; every simulated connection is labeled "Simulated" in the app. Restart
# `npm run dev` after changing it, and see `npm run jobs:tick -- --watch` in docs/development.md, step 10.
STACKDASH_SIMULATE_PROVIDERS=
# Local and e2e only, read only while STACKDASH_SIMULATE_PROVIDERS is 1: signs every simulated provider's webhook
# deliveries to <SITE_URL>/api/webhooks/<provider> in place of that provider's own secret (empty answers 503); e2e sets its own.
STACKDASH_SIMULATED_WEBHOOK_SECRET=

# Port of the dev server Playwright starts for `npm run test:e2e` (default 3100). Read from the shell
# when the Playwright config loads, not from .env.local: run `E2E_PORT=3200 npm run test:e2e`.
E2E_PORT=

# Port of the fake Resend API Playwright starts for e2e/alert-email.spec.ts (default E2E_PORT plus one,
# 3101). Read from the shell like E2E_PORT, not from .env.local.
E2E_RESEND_PORT=
