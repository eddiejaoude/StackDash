# Public origin of this deployment, e.g. the production domain once registered. Used to build
# absolute URLs in page metadata. Leave empty locally; set per environment in the host's settings.
NEXT_PUBLIC_SITE_URL=

# Supabase API URL. Locally: "API URL" from `supabase status`. Hosted: Project Settings, API.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...), safe for the browser because row level security
# applies. Locally: "Publishable key" from `supabase status`. Hosted: Project Settings, API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase service role key. Secret, server only, bypasses row level security; never prefix it
# with NEXT_PUBLIC_. Locally: SERVICE_ROLE_KEY from `supabase status -o env`. Hosted: Project
# Settings, API Keys.
SUPABASE_SERVICE_ROLE_KEY=

# Key that encrypts stored provider credentials (AES-256-GCM). Secret, server only, never prefix
# with NEXT_PUBLIC_, never store it in the database. Base64 of exactly 32 random bytes; generate
# one with `openssl rand -base64 32`. Losing it means every connection must reconnect.
DEVMACRO_ENCRYPTION_KEY=
# Previous keys kept readable during rotation, comma separated as keyId:base64Key, where keyId is
# the first 8 hex characters of the SHA-256 of the key. Leave empty unless rotating; see the
# header of scripts/rotate-encryption-key.ts and run `npm run keys:rotate`.
DEVMACRO_ENCRYPTION_KEYS_PREVIOUS=

# Bearer secret that POST /api/jobs/tick requires from the scheduler (pg_cron). Secret, server only,
# at least 32 characters; generate one with `openssl rand -hex 32`. `npm run jobs:tick` does not need it.
CRON_SECRET=

# GitHub OAuth app for signing in to DevMacro (not the GitHub App that reads billing data). Register
# one at https://github.com/settings/developers with the authorization callback URL
# http://127.0.0.1:55421/auth/v1/callback locally (hosted: https://<project-ref>.supabase.co/auth/v1/callback).
# Read by the Supabase CLI, not by Next.js: put these two in supabase/.env.local (git ignored) or
# export them before `supabase start`. The CLI refuses to start without them because the GitHub
# provider is enabled; any placeholder works when you only run the e2e suite, which never signs
# in through GitHub. Hosted: Authentication, Sign In / Providers, GitHub in the Supabase dashboard.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# ── Provider OAuth apps (#40, #88) ────────────────────────────────────────────────────────────────
# Each provider needs its own app registered by whoever runs this instance; docs/providers/<id>.md
# explains how. A provider with any required value empty shows "Not set up on this instance" in the
# catalog. Secrets are server only: never prefix them with NEXT_PUBLIC_. The callback URL for each
# is <SITE_URL>/api/connections/<id>/callback, where <SITE_URL> is NEXT_PUBLIC_SITE_URL when set,
# otherwise the origin the app is served from (http://localhost:3000 locally).

# Vercel Integration. Callback URL: <SITE_URL>/api/connections/vercel/callback
# Client id of the Vercel Integration (Integration Console, Credentials).
VERCEL_CLIENT_ID=
# Client secret of the Vercel Integration. Secret.
VERCEL_CLIENT_SECRET=
# URL slug of the integration, the <slug> in https://vercel.com/integrations/<slug>.
VERCEL_INTEGRATION_SLUG=

# GitHub App (not the sign-in OAuth app above). Callback URL and Setup URL: <SITE_URL>/api/connections/github/callback
# Client id of the GitHub App (app settings, General).
GITHUB_APP_CLIENT_ID=
# Client secret of the GitHub App. Secret.
GITHUB_APP_CLIENT_SECRET=
# URL slug of the app, the <slug> in https://github.com/apps/<slug>.
GITHUB_APP_SLUG=
# Numeric App ID of the GitHub App (app settings, General).
GITHUB_APP_ID=
# Private key of the GitHub App in PEM format, newlines as \n. Secret.
GITHUB_APP_PRIVATE_KEY=

# Resend OAuth client (registered through the Resend API). Callback URL: <SITE_URL>/api/connections/resend/callback
# Client id returned when the client was registered.
RESEND_CLIENT_ID=
# Client secret returned when the client was registered. Secret.
RESEND_CLIENT_SECRET=

# Stripe App. Callback URL (allowed_redirect_uris in the app manifest): <SITE_URL>/api/connections/stripe/callback
# Client id of the Stripe App (Dashboard, Apps, the app's OAuth settings).
STRIPE_APP_CLIENT_ID=
# Live mode secret key of the Stripe account that owns the app, used for the token exchange. Secret.
STRIPE_APP_SECRET_KEY=
# Optional test mode secret key, used instead of the live key for test mode installs. Secret.
STRIPE_APP_TEST_SECRET_KEY=

# Supabase OAuth app (organization settings, OAuth Apps). Callback URL: <SITE_URL>/api/connections/supabase/callback
# Client id of the Supabase OAuth app.
SUPABASE_OAUTH_CLIENT_ID=
# Client secret of the Supabase OAuth app. Secret.
SUPABASE_OAUTH_CLIENT_SECRET=

# Fake provider for tests and e2e only. Never set in production. Callback URL: <SITE_URL>/api/connections/fake/callback
# Set to exactly 1 to offer the in-memory "Example provider" and its dev-only consent screen.
DEVMACRO_ENABLE_FAKE_PROVIDER=
# Any non-empty value; the fake provider never sends it anywhere. Example: fake-client
FAKE_PROVIDER_CLIENT_ID=
# Any non-empty value; the fake provider never sends it anywhere. Example: fake-secret
FAKE_PROVIDER_CLIENT_SECRET=

# Simulated providers for local demos and testing only (#131). Never set in production; it is refused
# on a Vercel production deployment even when set. Set to exactly 1 to replace Vercel, GitHub,
# Resend, Stripe, and Supabase with simulated versions that need no OAuth app and make up their data
# on this machine; every simulated connection is labeled "Simulated" in the app. Restart
# `npm run dev` after changing it, and see `npm run jobs:tick -- --watch` in the README.
DEVMACRO_SIMULATE_PROVIDERS=

# Port of the dev server Playwright starts for `npm run test:e2e` (default 3100). Read from the shell
# when the Playwright config loads, not from .env.local: run `E2E_PORT=3200 npm run test:e2e`.
E2E_PORT=
