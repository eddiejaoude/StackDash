{
  "name": "stackdash",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "db:types:check": "supabase gen types typescript --local --schema public > \"${TMPDIR:-/tmp}/stackdash-database.types.ts\" && diff -u src/lib/supabase/database.types.ts \"${TMPDIR:-/tmp}/stackdash-database.types.ts\"",
    "keys:rotate": "tsx --conditions=react-server scripts/rotate-encryption-key.ts",
    "invite": "tsx --conditions=react-server scripts/invite.ts",
    "jobs:tick": "tsx --conditions=react-server scripts/tick.ts",
    "demo": "tsx --conditions=react-server scripts/demo.ts",
    "demo:seed": "tsx --conditions=react-server scripts/demo-seed.ts",
    "demo:event": "tsx --conditions=react-server scripts/demo-event.ts",
    "email:fake": "tsx scripts/fake-resend-api.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.38.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "unrs-resolver": false
  }
}
